# Local defaults. Copy to .env privately; never commit filled-in secrets.
# Python 3.12+ is required. See docs/deployment.md before deploying.
APP_ENV=development
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=scu.edu

# Local development uses SQLite and files. Free Render requires external storage.
DATABASE_URL=sqlite:///broncoshub.db
COVER_UPLOAD_DIR=
COVER_STORAGE_BACKEND=local
REQUIRE_EXTERNAL_STORAGE=false
# Hosted PostgreSQL: use the Supabase session-pooler URI with a dedicated app role.
DATABASE_SCHEMA=broncoshub
DATABASE_SSL_ROOT_CERT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=event-covers

# Production needs its real HTTPS origin and hostname, without paths.
PUBLIC_BASE_URL=
TRUSTED_HOSTS=
# Enable only behind the deployment's trusted reverse proxy.
TRUST_PROXY=false

# Free events work with payments disabled. Never use mock in production.
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
